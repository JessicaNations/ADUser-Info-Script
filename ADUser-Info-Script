# Export Active Directory user attributes to an Excel spreadsheet

Import-Module ActiveDirectory
Import-Module ImportExcel

$path = "$env:USERPROFILE\Desktop\ADUser-Attributes_$(Get-Date -Format 'MM-dd-yyyy').xlsx"

$users = Get-ADUser -Filter * -Properties * |
    Select-Object `
        sn,
        SamAccountName,
        Description,
        @{Name='AccountExpirationDate'; Expression={ if ($_.AccountExpirationDate) { $_.AccountExpirationDate.ToString('MM/dd/yyyy') } else { $null } }},
        Enabled,
        PasswordNeverExpires,
        @{Name='LastLogonDate'; Expression={ if ($_.LastLogonDate) { $_.LastLogonDate.ToString('MM/dd/yyyy') } else { $null } }}

$excelPackage = $users | Export-Excel -Path $path `
    -WorksheetName 'AD Users' `
    -TableStyle 'Light21' `
    -BoldTopRow `
    -AutoSize `
    -FreezeTopRow `
    -PassThru

$ws = $excelPackage.Workbook.Worksheets['AD Users']

# Apply formatting to the used range
Set-Format -Worksheet $ws -Range $ws.Dimension.Address -WrapText -HorizontalAlignment Left -VerticalAlignment Top

# Save and close
Close-ExcelPackage $excelPackage
